testDistributionRejectsReplayedSettlementId : Script ()
testDistributionRejectsReplayedSettlementId = script do
  (operator, pending) <- setup
  active <- fundAndActivate operator pending
  setTime (time (date 2026 Jan 4) 0 0 0)
  nextRecipients1 <- replacementAuthorizations operator active "-next-1"
  settledOnce <- submit operator $ exerciseCmd active RecordDistributionSettlement with
    grossAmount = 684.93
    settledLegs =
      [ DistributionSettlementLeg with legId = "supplier"; amount = 616.437
      , DistributionSettlementLeg with legId = "facilitator"; amount = 68.493
      ]
    settlementId = "settlement-update-1"
    settledAt = time (date 2026 Jan 2) 0 0 0
    newAllocationCid = Some "allocation-2"
    newRecipientAuthorizations = nextRecipients1
    expectedSequence = 1
  nextRecipients2 <- replacementAuthorizations operator settledOnce "-next-2"
  settledTwice <- submit operator $ exerciseCmd settledOnce RecordDistributionSettlement with
    grossAmount = 684.93
    settledLegs =
      [ DistributionSettlementLeg with legId = "supplier"; amount = 616.437
      , DistributionSettlementLeg with legId = "facilitator"; amount = 68.493
      ]
    settlementId = "settlement-update-2"
    settledAt = time (date 2026 Jan 3) 0 0 0
    newAllocationCid = Some "allocation-3"
    newRecipientAuthorizations = nextRecipients2
    expectedSequence = 2
  nextRecipients3 <- replacementAuthorizations operator settledTwice "-next-3"
  submitMustFail operator $ exerciseCmd settledTwice RecordDistributionSettlement with
    grossAmount = 684.93
    settledLegs =
      [ DistributionSettlementLeg with legId = "supplier"; amount = 616.437
      , DistributionSettlementLeg with legId = "facilitator"; amount = 68.493
      ]
    settlementId = "settlement-update-1"
    settledAt = time (date 2026 Jan 4) 0 0 0
    newAllocationCid = Some "allocation-4"
    newRecipientAuthorizations = nextRecipients3
    expectedSequence = 3

testDistributionFixedAmountsScaleWithBatch : Script ()
testDistributionFixedAmountsScaleWithBatch = script do
  operator <- allocateParty "FixedOperator"
  payer <- allocateParty "FixedPayer"
  supplier <- allocateParty "FixedSupplier"
  facilitator <- allocateParty "FixedFacilitator"
  let start = time (date 2026 Jan 1) 0 0 0
      legs =
        [ DistributionLeg with
            legId = "supplier"
            receiver = AccountV2 with owner = supplier; provider = None; id = ""
            rule = FixedAmountPerPeriod with amount = 90.0
        , DistributionLeg with
            legId = "facilitator"
            receiver = AccountV2 with owner = facilitator; provider = None; id = ""
            rule = FixedAmountPerPeriod with amount = 10.0
        ]
  pending <- submit operator $ createCmd DistributionStreamRecord with
    streamId = "fixed-distribution"
    operator
    payerAccount = AccountV2 with owner = payer; provider = None; id = ""
    instrumentId = InstrumentIdV2 with admin = operator; id = "CC"
    grossAmountPerPeriod = 100.0
    periodSeconds = 86400
    startTime = start
    endTime = None
    legs
    fundingMode = EscrowFunding
    totalFunded = 1000.0
    totalGrossSettled = 0.0
    fundingCount = 1
    settlementCount = 0
    currentAllocationCid = Some "allocation-fixed-1"
    originalAllocationId = Some "allocation-fixed-1"
    lastFundingId = Some "funding-fixed-1"
    lastSettlementId = None
    fundingIds = ["funding-fixed-1"]
    settlementIds = []
    recipientAuthorizations =
      [ DistributionRecipientAuthorization with
          receiver = AccountV2 with owner = supplier; provider = None; id = ""
          authorizationId = "fixed-supplier-authorization"
          allocationCid = "fixed-supplier-allocation"
      , DistributionRecipientAuthorization with
          receiver = AccountV2 with owner = facilitator; provider = None; id = ""
          authorizationId = "fixed-facilitator-authorization"
          allocationCid = "fixed-facilitator-allocation"
      ]
    recipientAuthorizationIds =
      ["fixed-supplier-authorization", "fixed-facilitator-authorization"]
    currentSettlementDeadline = Some (time (date 2027 Jan 1) 0 0 0)
    status = AwaitingRecipients
    observers = []
  active <- submit operator $ exerciseCmd pending ActivateDistribution
  setTime (time (date 2026 Jan 4) 0 0 0)
  nextRecipients <- replacementAuthorizations operator active "-next"
  settled <- submit operator $ exerciseCmd active RecordDistributionSettlement with
    grossAmount = 300.0
    settledLegs =
      [ DistributionSettlementLeg with legId = "supplier"; amount = 270.0
      , DistributionSettlementLeg with legId = "facilitator"; amount = 30.0
      ]
    settlementId = "settlement-fixed-1"
    settledAt = time (date 2026 Jan 4) 0 0 0
    newAllocationCid = Some "allocation-fixed-2"
    newRecipientAuthorizations = nextRecipients
    expectedSequence = 1
  Some result <- queryContractId operator settled
  assertMsg "fixed amount batch recorded" (result.totalGrossSettled == 300.0)

