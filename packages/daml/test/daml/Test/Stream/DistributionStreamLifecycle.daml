testDistributionRejectsOverlappingFunding : Script ()
testDistributionRejectsOverlappingFunding = script do
  (operator, pending) <- setup
  fundedOnce <- submit operator $ exerciseCmd pending RecordDistributionFunding with
    amount = 684.93
    fundingId = "funding-update-1"
    allocationCid = "allocation-1"
    originalAllocationCid = None
    settlementDeadline = time (date 2027 Jan 1) 0 0 0
    expectedSequence = 1
  submitMustFail operator $ exerciseCmd fundedOnce RecordDistributionFunding with
    amount = 684.93
    fundingId = "funding-update-2"
    allocationCid = "allocation-2"
    originalAllocationCid = Some "allocation-1"
    settlementDeadline = time (date 2027 Jan 1) 0 0 0
    expectedSequence = 2

testDistributionRejectsReplayedFundingId : Script ()
testDistributionRejectsReplayedFundingId = script do
  (operator, pending) <- setup
  active <- fundAndActivate operator pending
  setTime (time (date 2026 Jan 31) 0 0 0)
  exhausted <- submit operator $ exerciseCmd active RecordDistributionSettlement with
    grossAmount = 20547.90
    settledLegs =
      [ DistributionSettlementLeg with legId = "supplier"; amount = 18493.11
      , DistributionSettlementLeg with legId = "facilitator"; amount = 2054.79
      ]
    settlementId = "settlement-update-1"
    settledAt = time (date 2026 Jan 31) 0 0 0
    newAllocationCid = None
    newRecipientAuthorizations = []
    expectedSequence = 1
  fundedAgain <- submit operator $ exerciseCmd exhausted RecordDistributionFunding with
    amount = 684.93
    fundingId = "funding-update-2"
    allocationCid = "allocation-2"
    originalAllocationCid = Some "allocation-2"
    settlementDeadline = time (date 2027 Jan 1) 0 0 0
    expectedSequence = 2
  Some fundedAgainRecord <- queryContractId operator fundedAgain
  authorizedAgain <- authorizeReceivers operator fundedAgain "funding-2"
    (configuredReceiverAccounts fundedAgainRecord.legs) 1
  activeAgain <- submit operator $ exerciseCmd authorizedAgain ActivateDistribution
  setTime (time (date 2026 Feb 1) 0 0 0)
  exhaustedAgain <- submit operator $ exerciseCmd activeAgain RecordDistributionSettlement with
    grossAmount = 684.93
    settledLegs =
      [ DistributionSettlementLeg with legId = "supplier"; amount = 616.437
      , DistributionSettlementLeg with legId = "facilitator"; amount = 68.493
      ]
    settlementId = "settlement-update-2"
    settledAt = time (date 2026 Feb 1) 0 0 0
    newAllocationCid = None
    newRecipientAuthorizations = []
    expectedSequence = 2
  submitMustFail operator $ exerciseCmd exhaustedAgain RecordDistributionFunding with
    amount = 684.93
    fundingId = "funding-update-1"
    allocationCid = "allocation-3"
    originalAllocationCid = Some "allocation-1"
    settlementDeadline = time (date 2027 Jan 1) 0 0 0
    expectedSequence = 3

