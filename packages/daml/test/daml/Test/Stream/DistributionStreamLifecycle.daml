module Test.Stream.DistributionStreamLifecycle where

import Daml.Script
import DA.Date (date, Month(..))
import DA.Time (time)

import CantonStreams.Interface.Types
import CantonStreams.Stream.StreamRecord (FundingMode(..))
import CantonStreams.Stream.DistributionStream

setup : Script (Party, ContractId DistributionStreamRecord)
setup = do
  operator <- allocateParty "Operator"
  payer <- allocateParty "Payer"
  supplier <- allocateParty "Supplier"
  facilitator <- allocateParty "Facilitator"
  let start = time (date 2026 Jan 1) 0 0 0
      record = DistributionStreamRecord with
        streamId = "distribution-001"
        operator
        payerAccount = AccountV2 with owner = payer; provider = None; id = ""
        instrumentId = InstrumentIdV2 with admin = operator; id = "CC"
        grossAmountPerPeriod = 684.93
        periodSeconds = 86400
        startTime = start
        endTime = None
        legs =
          [ DistributionLeg with
              legId = "supplier"
              receiver = AccountV2 with owner = supplier; provider = None; id = ""
              rule = PercentageBps with basisPoints = 9000
          , DistributionLeg with
              legId = "facilitator"
              receiver = AccountV2 with owner = facilitator; provider = None; id = ""
              rule = PercentageBps with basisPoints = 1000
          ]
        fundingMode = EscrowFunding
        totalFunded = 0.0
        totalGrossSettled = 0.0
        fundingCount = 0
        settlementCount = 0
        currentAllocationCid = None
        originalAllocationId = None
        lastFundingId = None
        lastSettlementId = None
        fundingIds = []
        settlementIds = []
        recipientAuthorizations = []
        recipientAuthorizationIds = []
        currentSettlementDeadline = None
        status = AwaitingFunding
        observers = []
  cid <- submit operator $ createCmd record
  pure (operator, cid)

authorizeReceivers
  : Party
  -> ContractId DistributionStreamRecord
  -> Text
  -> [AccountV2]
  -> Int
  -> Script (ContractId DistributionStreamRecord)
authorizeReceivers _ cid _ [] _ = pure cid
authorizeReceivers operator cid prefix (receiver :: rest) count = do
  next <- submit operator $ exerciseCmd cid RecordDistributionRecipientAuthorization with
    receiver
    authorizationId = prefix <> ":recipient-authorization-" <> show count
    allocationCid = prefix <> ":recipient-allocation-" <> show count
    expectedCount = count
  authorizeReceivers operator next prefix rest (count + 1)

nextRecipientAuthorizations
  : Text
  -> [DistributionRecipientAuthorization]
  -> [DistributionRecipientAuthorization]
nextRecipientAuthorizations suffix =
  map (\authorization -> authorization with
    allocationCid = authorization.allocationCid <> suffix)

replacementAuthorizations
  : Party
  -> ContractId DistributionStreamRecord
  -> Text
  -> Script [DistributionRecipientAuthorization]
replacementAuthorizations operator cid suffix = do
  Some record <- queryContractId operator cid
  pure (nextRecipientAuthorizations suffix record.recipientAuthorizations)

fundAndActivate : Party -> ContractId DistributionStreamRecord -> Script (ContractId DistributionStreamRecord)
fundAndActivate operator cid = do
  funded <- submit operator $ exerciseCmd cid RecordDistributionFunding with
    amount = 20547.90
    fundingId = "funding-update-1"
    allocationCid = "allocation-1"
    originalAllocationCid = None
    settlementDeadline = time (date 2027 Jan 1) 0 0 0
    expectedSequence = 1
  Some fundedRecord <- queryContractId operator funded
  authorized <- authorizeReceivers operator funded "funding-1"
    (configuredReceiverAccounts fundedRecord.legs) 1
  submit operator $ exerciseCmd authorized ActivateDistribution

testDistribution90_10 : Script ()
testDistribution90_10 = script do
  (operator, pending) <- setup
  active <- fundAndActivate operator pending
  setTime (time (date 2026 Jan 8) 0 0 0)
  nextRecipients <- replacementAuthorizations operator active "-next"
  settled <- submit operator $ exerciseCmd active RecordDistributionSettlement with
    grossAmount = 4794.51
    settledLegs =
      [ DistributionSettlementLeg with legId = "supplier"; amount = 4315.059
      , DistributionSettlementLeg with legId = "facilitator"; amount = 479.451
      ]
    settlementId = "settlement-update-1"
    settledAt = time (date 2026 Jan 8) 0 0 0
    newAllocationCid = Some "allocation-2"
    newRecipientAuthorizations = nextRecipients
    expectedSequence = 1
  Some result <- queryContractId operator settled
  assertMsg "gross total recorded" (result.totalGrossSettled == 4794.51)
  assertMsg "settlement sequence advanced" (result.settlementCount == 1)
  assertMsg "allocation chain advanced" (result.currentAllocationCid == Some "allocation-2")

